# Hugging Face
# Required when the configured dataset needs authenticated access.
HF_TOKEN=

# Weights & Biases
# Set this instead of running `wandb login` interactively.
WANDB_API_KEY=

# Common values: online, offline, disabled.
WANDB_MODE=online

# Optional defaults for W&B runs.
WANDB_PROJECT=seq2seq-transformer
WANDB_ENTITY=
